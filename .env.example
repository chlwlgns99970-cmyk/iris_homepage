NODE_ENV=development
WEB_PORT=3000
# 로컬 개발 기본값입니다. Docker에서 API 컨테이너를 추가하는 경우에만 0.0.0.0처럼 명시합니다.
API_HOST=127.0.0.1
API_PORT=3001
WEB_BASE_URL=http://localhost:3000
API_BASE_URL=http://localhost:3001
# Next.js 서버의 /api/* Rewrite 대상입니다. Vercel Production에서는 Dashboard에
# HTTPS Origin을 등록하고, Preview에는 별도 Staging API가 있을 때만 등록합니다.
VPS_API_ORIGIN=
# 개발환경은 localhost를 사용합니다. 운영에서는 실제 API Origin을 지정하거나
# 웹과 API가 같은 Origin이면 빈 값으로 두어 상대 경로를 사용합니다.
NEXT_PUBLIC_API_BASE_URL=http://localhost:3001
DATABASE_URL=postgresql://app:change-me@localhost:5432/natebe_rpg
REDIS_URL=redis://localhost:6379
# 쉼표로 구분한 정확한 http(s) Origin만 허용됩니다. 와일드카드는 사용할 수 없습니다.
CORS_ORIGINS=http://localhost:3000
SESSION_SECRET=
TOKEN_HASH_SECRET=
# 봇 → 홈페이지 승인 전용 토큰입니다. 아래 BOT_INTERNAL_API_TOKEN과 혼용하지 않습니다.
WEB_AUTH_ENABLED=false
WEB_AUTH_INTERNAL_TOKEN=
WEB_AUTH_REQUEST_TTL_MS=300000
WEB_AUTH_CLEANUP_RETENTION_MS=604800000
WEB_SESSION_TTL_MS=2592000000
WEB_SESSION_COOKIE_NAME=natebe_session
IRIS_API_BASE_URL=
IRIS_API_TOKEN=
BOT_INTERNAL_API_URL=
BOT_INTERNAL_API_TOKEN=
PORTAL_ENABLED=false
PORTAL_REQUEST_TIMEOUT_MS=3000
PORTAL_MAX_RESPONSE_BYTES=524288
PORTAL_CACHE_TTL_MS=3000
PAYMENT_PROVIDER=disabled
# 실제 PG 확정 전에는 disabled를 유지합니다. mock은 NODE_ENV=test에서만 허용됩니다.
PAYMENT_FULFILLMENT_ENABLED=false
RPG_PAYMENT_INTERNAL_API_URL=http://127.0.0.1:5000
RPG_PAYMENT_INTERNAL_API_TOKEN=
RPG_PAYMENT_INTERNAL_API_TIMEOUT_MS=5000
TOSS_CLIENT_KEY=
TOSS_SECRET_KEY=
# 브라우저에 공개 가능한 사업자 표시값만 NEXT_PUBLIC에 입력합니다.
NEXT_PUBLIC_BUSINESS_NAME=
NEXT_PUBLIC_BUSINESS_REPRESENTATIVE=
NEXT_PUBLIC_BUSINESS_REGISTRATION_NUMBER=
NEXT_PUBLIC_ECOMMERCE_REGISTRATION_NUMBER=
NEXT_PUBLIC_BUSINESS_ADDRESS=
NEXT_PUBLIC_CUSTOMER_SUPPORT_PHONE=
NEXT_PUBLIC_CUSTOMER_SUPPORT_EMAIL=
